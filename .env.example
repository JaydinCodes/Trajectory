# Supabase (required for Vercel and the production data backend).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to supabase for hosted production. SQLite remains an explicit local rollback/test backend.
TRAJECTORY_DATA_BACKEND=sqlite

# Optional local SQLite database override. Defaults to data/trajectory.db.
TRAJECTORY_DB_PATH=

# Explicit local-only visual fixture switch. Keep false for normal use.
TRAJECTORY_SEED_DEMO=false
